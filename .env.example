# Application config
RUNTIME__APP_ENV=local
SERVICE__NAME=tasks-worker-service
SERVICE__TITLE=Tasks Worker Service
SERVICE__API_PREFIX=/v1
SECURITY__SERVICE_API_KEY=<replace-me>
SECURITY__DISABLE_AUTH=false
SECURITY__ALLOWED_ORIGINS=http://localhost:3000
DATABASE__URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:25435/tasks_worker_service
DATABASE__SSL=false
DATABASE__POOL_SIZE=5
DATABASE__MAX_OVERFLOW=10
REDIS__ENABLED=false
REDIS__URL=redis://127.0.0.1:26382/0

# Worker template / Job Platform integration
TASKIQ__BROKER_KIND=redis_stream
TASKIQ__REDIS_URL=redis://127.0.0.1:26380/0
TASKIQ__TASK_NAME=job-platform.consume_queue_envelope
TASKIQ__QUEUE_NAME=job.example-task.v1
WORKER__SERVICE_NAME=worker-x
WORKER__WORKER_NAME=worker-x-taskiq
WORKER__WORKER_SESSION_ID=worker-x-local
WORKER__JOB_SERVICE_BASE_URL=http://127.0.0.1:8110/internal/v1
WORKER__JOB_SERVICE_API_KEY=dev-worker-key
WORKER__JOB_SERVICE_REGISTRY_API_KEY=dev-registry-key
WORKER__MANIFEST_PATH=app/worker/manifest.json

STORAGE__BACKEND=aliyun_oss
STORAGE__LOCAL_PATH=storage/objects
STORAGE__ENDPOINT=
STORAGE__PUBLIC_ENDPOINT=
STORAGE__ENDPOINT_STYLE=virtual_host
STORAGE__SCHEME=https
STORAGE__BUCKET=
STORAGE__REGION=
STORAGE__PROJECT_ROOT=
STORAGE__ACCESS_KEY_ID=
STORAGE__ACCESS_KEY_SECRET=

AUDIO_STEM__MODEL_DIR=.data/models/htdemucs-ft
AUDIO_STEM__EXECUTION_PROVIDER=CPUExecutionProvider
AUDIO_STEM__INPUT_BUCKET=<oss-bucket>
AUDIO_STEM__INPUT_REGION=<oss-region>
AUDIO_STEM__MAX_INPUT_BYTES=209715200
AUDIO_STEM__OUTPUT_PREFIX=audio-stem-separation
AUDIO_STEM__OUTPUT_BUCKET=<oss-bucket>
AUDIO_STEM__OUTPUT_REGION=<oss-region>
AUDIO_STEM__MAX_DURATION_SECONDS=3600
AUDIO_STEM_TRITON__URL=http://127.0.0.1:8000
AUDIO_STEM_TRITON__TOKEN=
AUDIO_STEM_TRITON__MODEL_VERSION=1
AUDIO_STEM_TRITON__REQUEST_TIMEOUT_SECONDS=30

HTTP_CLIENT__TIMEOUT_SECONDS=5
OBSERVABILITY__LOG_LEVEL=INFO
OBSERVABILITY__ACCESS_LOG_ENABLED=true
OBSERVABILITY__HEALTH_ACCESS_LOG=false

# Launcher config
API_HOST=127.0.0.1
API_PORT=8130
API_HOST_PORT=8130
COMPOSE_PROJECT_NAME=tasks-worker-service
POSTGRES_DB=tasks_worker_service
POSTGRES_HOST_PORT=25435
REDIS_HOST_PORT=26382
