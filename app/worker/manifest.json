{
  "manifest_version": 1,
  "worker_service": "worker-x",
  "queue_name": "job.example-task.v1",
  "capabilities": ["cpu", "audio-stem", "local-storage"],
  "tasks": [
    {
      "task_name": "example.task",
      "task_version": 1,
      "handler": "app.worker.task_modules.example.handler:ExampleTaskHandler",
      "input_schema": {
        "type": "object",
        "additionalProperties": true
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": true
      },
      "timeout_seconds": 300,
      "max_retries": 1,
      "retry_policy": {},
      "idempotency_retention_seconds": 86400,
      "required_worker_capabilities": ["cpu"],
      "caller_bindings": [
        {
          "caller_service": "business-api-a",
          "callback_url": null,
          "compensation_window_seconds": 3600
        }
      ]
    },
    {
      "task_name": "example.object_ref",
      "task_version": 1,
      "handler": "app.worker.task_modules.object_ref_example.handler:ObjectRefExampleHandler",
      "input_schema": {
        "type": "object",
        "additionalProperties": true
      },
      "output_schema": {
        "type": "object",
        "required": ["ok", "idempotency_key", "source_uri", "result_uri"],
        "properties": {
          "ok": {"type": "boolean"},
          "idempotency_key": {"type": "string"},
          "source_uri": {"type": "string"},
          "result_uri": {"type": "string"}
        },
        "additionalProperties": false
      },
      "timeout_seconds": 300,
      "max_retries": 1,
      "retry_policy": {},
      "idempotency_retention_seconds": 86400,
      "required_worker_capabilities": ["cpu"],
      "caller_bindings": [
        {
          "caller_service": "business-api-a",
          "callback_url": null,
          "compensation_window_seconds": 3600
        }
      ]
    },
    {
      "task_name": "example.long_running",
      "task_version": 1,
      "handler": "app.worker.task_modules.long_running_example.handler:LongRunningExampleHandler",
      "input_schema": {
        "type": "object",
        "additionalProperties": true
      },
      "output_schema": {
        "type": "object",
        "required": ["ok", "steps_completed", "worker"],
        "properties": {
          "ok": {"type": "boolean"},
          "steps_completed": {"type": "integer"},
          "worker": {"type": "string"}
        },
        "additionalProperties": false
      },
      "timeout_seconds": 600,
      "max_retries": 0,
      "retry_policy": {},
      "idempotency_retention_seconds": 86400,
      "required_worker_capabilities": ["cpu"],
      "caller_bindings": [
        {
          "caller_service": "business-api-a",
          "callback_url": null,
          "compensation_window_seconds": 3600
        }
      ]
    },
    {
      "task_name": "example.failing",
      "task_version": 1,
      "handler": "app.worker.task_modules.failing_example.handler:FailingExampleHandler",
      "input_schema": {
        "type": "object",
        "properties": {
          "message": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": true
      },
      "timeout_seconds": 300,
      "max_retries": 0,
      "retry_policy": {},
      "idempotency_retention_seconds": 86400,
      "required_worker_capabilities": ["cpu"],
      "caller_bindings": [
        {
          "caller_service": "business-api-a",
          "callback_url": null,
          "compensation_window_seconds": 3600
        }
      ]
    },
    {
      "task_name": "audio_stem_separation",
      "task_version": 1,
      "handler": "app.worker.task_modules.audio_stem_separation.handler:AudioStemSeparationHandler",
      "input_schema": {
        "type": "object",
        "required": ["input_audio"],
        "properties": {
          "input_audio": {
            "type": "object",
            "required": ["scheme", "bucket", "region", "key", "content_type", "sha256", "size_bytes"],
            "properties": {
              "scheme": {"type": "string", "enum": ["local"]},
              "bucket": {"type": "string", "minLength": 1},
              "region": {"type": "string", "minLength": 1},
              "key": {"type": "string", "minLength": 1},
              "content_type": {"type": "string", "enum": ["audio/wav", "audio/x-wav"]},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "size_bytes": {"type": "integer", "minimum": 1},
              "version_id": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "model_service": {"type": "string", "enum": ["local"]},
          "payload_schema_version": {"type": "string"},
          "max_duration_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 3600}
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["ok", "model_service", "stems", "sample_rate", "channels", "duration_seconds", "segment_count"],
        "properties": {
          "ok": {"type": "boolean"},
          "model_service": {"type": "string", "enum": ["local"]},
          "stems": {"type": "object"},
          "sample_rate": {"type": "integer"},
          "channels": {"type": "integer"},
          "duration_seconds": {"type": "number"},
          "segment_count": {"type": "integer"},
          "execution_provider": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      },
      "timeout_seconds": 2400,
      "max_retries": 0,
      "retry_policy": {},
      "idempotency_retention_seconds": 86400,
      "required_worker_capabilities": ["cpu", "audio-stem", "local-storage"],
      "caller_bindings": [
        {
          "caller_service": "business-api-a",
          "callback_url": null,
          "compensation_window_seconds": 3600
        }
      ]
    },
    {
      "task_name": "audio_stem_separation_triton",
      "task_version": 1,
      "handler": "app.worker.task_modules.audio_stem_separation_triton.handler:AudioStemSeparationTritonHandler",
      "input_schema": {
        "type": "object",
        "required": ["input_audio"],
        "properties": {
          "input_audio": {
            "type": "object",
            "required": ["scheme", "bucket", "region", "key", "content_type", "sha256", "size_bytes"],
            "properties": {
              "scheme": {"type": "string", "enum": ["local"]},
              "bucket": {"type": "string", "minLength": 1},
              "region": {"type": "string", "minLength": 1},
              "key": {"type": "string", "minLength": 1},
              "content_type": {"type": "string", "enum": ["audio/wav", "audio/x-wav"]},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "size_bytes": {"type": "integer", "minimum": 1},
              "version_id": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "model_service": {"type": "string", "enum": ["triton"]},
          "payload_schema_version": {"type": "string"},
          "max_duration_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 3600}
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["ok", "model_service", "stems", "sample_rate", "channels", "duration_seconds", "segment_count"],
        "properties": {
          "ok": {"type": "boolean"},
          "model_service": {"type": "string", "enum": ["triton"]},
          "stems": {"type": "object"},
          "sample_rate": {"type": "integer"},
          "channels": {"type": "integer"},
          "duration_seconds": {"type": "number"},
          "segment_count": {"type": "integer"},
          "triton_model_version": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      },
      "timeout_seconds": 2400,
      "max_retries": 0,
      "retry_policy": {},
      "idempotency_retention_seconds": 86400,
      "required_worker_capabilities": ["cpu", "audio-stem", "local-storage"],
      "caller_bindings": [
        {
          "caller_service": "business-api-a",
          "callback_url": null,
          "compensation_window_seconds": 3600
        }
      ]
    }
  ]
}
