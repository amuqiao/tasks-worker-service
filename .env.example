# Application config
RUNTIME__APP_ENV=local
SERVICE__NAME=fastapi-lite
SERVICE__TITLE=FastAPI Lite
SERVICE__API_PREFIX=/v1
SECURITY__SERVICE_API_KEY=<replace-me>
SECURITY__DISABLE_AUTH=false
SECURITY__ALLOWED_ORIGINS=http://localhost:3000
DATABASE__URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:25432/fastapi_lite
DATABASE__SSL=false
DATABASE__POOL_SIZE=5
DATABASE__MAX_OVERFLOW=10
REDIS__ENABLED=false
REDIS__URL=redis://127.0.0.1:26379/0

# Worker template / Job Platform integration
TASKIQ__BROKER_KIND=redis_stream
TASKIQ__REDIS_URL=redis://127.0.0.1:26379/0
TASKIQ__TASK_NAME=job-platform.consume_queue_envelope
TASKIQ__QUEUE_NAME=job.example-task.v1
WORKER__SERVICE_NAME=worker-x
WORKER__WORKER_NAME=worker-x-taskiq
WORKER__WORKER_SESSION_ID=worker-x-local
WORKER__JOB_SERVICE_BASE_URL=http://127.0.0.1:8100/internal/v1
WORKER__JOB_SERVICE_API_KEY=dev-worker-key
WORKER__JOB_SERVICE_REGISTRY_API_KEY=dev-registry-key
WORKER__MANIFEST_PATH=app/worker/manifest.json

STORAGE__BACKEND=disabled
STORAGE__LOCAL_PATH=storage/objects
STORAGE__ENDPOINT=
STORAGE__BUCKET=
STORAGE__REGION=
STORAGE__ACCESS_KEY_ID=
STORAGE__ACCESS_KEY_SECRET=
HTTP_CLIENT__TIMEOUT_SECONDS=5
OBSERVABILITY__LOG_LEVEL=INFO
OBSERVABILITY__ACCESS_LOG_ENABLED=true
OBSERVABILITY__HEALTH_ACCESS_LOG=false

# Launcher config
API_HOST=127.0.0.1
API_PORT=8100
API_HOST_PORT=8100
COMPOSE_PROJECT_NAME=fastapi-lite
POSTGRES_DB=fastapi_lite
POSTGRES_HOST_PORT=25432
REDIS_HOST_PORT=26379
